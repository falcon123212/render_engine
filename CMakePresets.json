{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "VS 2022 x64, vcpkg release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-release"
      },
      "environment": {
        "VCPKG_MAX_CONCURRENCY": "6"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo",
      "nativeToolOptions": ["/m:6"]
    }
  ]
}
