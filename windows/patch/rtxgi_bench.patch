+// ---- banc : masque de dependances par entree SHaRC
+// 96 bits de zones (grille 6 x 4 x 4 dans la boite benchGridMin..Max) + 32 bits de lampes (bit 31 = ciel)
+#define DEP_GX 6
+#define DEP_GY 4
+#define DEP_GZ 4
+#if SHARC_UPDATE
+RWStructuredBuffer<uint4>                   u_BenchDep                      : register(u4, space3);   // banque 0
+RWStructuredBuffer<uint4>                   u_BenchDep1                     : register(u7, space3);   // banque 1
+
+void DepMarkPoint(inout uint3 m, float3 p)
+{
+    float3 c = (p - g_Global.benchGridMin.xyz) / (g_Global.benchGridMax.xyz - g_Global.benchGridMin.xyz) * float3(DEP_GX, DEP_GY, DEP_GZ);
+    if (any(c < 0.0f) || any(c >= float3(DEP_GX, DEP_GY, DEP_GZ)))
+        return;
+    uint3 v = uint3(c);
+    uint b = v.x + DEP_GX * (v.y + DEP_GY * v.z);
+    uint bit = 1u << (b & 31u);
+    if (b < 32u) m.x |= bit;
+    else if (b < 64u) m.y |= bit;
+    else m.z |= bit;
+}
+
+// zones traversees par le segment a -> b (decoupe a la boite, pas d'un demi-cote de zone)
+void DepMarkSegment(inout uint3 m, float3 a, float3 b)
+{
+    float3 lo = g_Global.benchGridMin.xyz;
+    float3 hi = g_Global.benchGridMax.xyz;
+    float3 d = b - a;
