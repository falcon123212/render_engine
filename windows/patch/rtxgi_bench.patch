+// Banc d'essai automatique (ajoute pour la recherche "cache a dependances") :
+//   Pathtracer.exe -bench <fichier.txt>
+// Fichier : lignes "cle valeurs"
+//   mode ref|run            ref : accumule refframes images par etat et enregistre ref_<k>.bin
+//                           run : deroule la timeline, mesure l'erreur de chaque image contre ref_<etat>.bin
+//   tech none|sharc|nrc
+//   spp <n>                 echantillons par pixel et par image
+//   out <dossier>
+//   warmup <n>              images de chauffe avant le debut (etat de la 1re etape)
+//   state <soleil> <ciel> <lampe0> <lampe1> ...   facteurs d'intensite (1 = valeur de la scene)
+//   refframes <n>
+//   timeline <etat>:<images>,<etat>:<images>,...
+//   capture <image>,<image>,...      images a enregistrer en entier (run)
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <array>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+struct BenchState { float sun = 1.f, sky = 1.f; std::vector<float> lights; int obj = 0; };
+
+struct BenchConfig
+{
+    bool active = false;
+    std::string mode = "run", tech = "none", out = ".", denoiser = "accum";
+    int spp = 1, warmup = 60, refFrames = 256, sharcAccum = -1;
+    float nrcMaxRad = -1.f;
+    int snapshots = 0, eventBoost = 0, eventClear = 0, eventBypass = 0, bypassBounces = 0, bypassAdaptive = 0;
+    int depInv = 0, compactSnap = 0, depReset = 0, dlssReset = 0;
+    std::string dlss = "none";   // none | perf | balanced | quality | dlaa
+    std::string refDir;          // dossier des references ; vide = <out>/../ref
+    float gridMin[3] = { -20.f, -0.5f, 8.f }, gridMax[3] = { -4.f, 7.5f, 24.f };
+    std::string objNode;                                 // objet mobile : nom du noeud, positions, demi-taille
+    std::vector<std::array<float, 6>> objPos;   // position, et taille optionnelle (-1 = celle de la scene)
+    float objHalf[3] = { 0.f, 0.f, 0.f };
+    float camAmp = 0.f, camYaw = 0.f; int camPeriod = 0, poses = 0;   // camera mobile, references par pose
+    std::vector<int> seqPose;
+    std::string probesPath;
+    std::vector<uint8_t> probes;
+    int probeW = 0, probeH = 0;   // briques : instantanes par etat, reaction declenchee par l'evenement
+    std::vector<BenchState> states;
+    std::vector<int> seq, captures;
+
+    // execution
+    int frame = -1;
+    bool origSaved = false;
+    float origSun = 0.f, origSky = 0.f;
+    std::vector<float> origLights;
+    std::vector<std::vector<float>> refs;
+    int refW = 0, refH = 0;
+    FILE* csv = nullptr;
+
+    bool Load(const char* path)
+    {
+        std::ifstream f(path);
+        if (!f) return false;
+        std::string line;
+        std::vector<std::pair<int, int>> timeline;
+        while (std::getline(f, line))
+        {
+            if (line.empty() || line[0] == '#') continue;
+            std::istringstream ss(line);
+            std::string k; ss >> k;
+            if (k == "mode") ss >> mode;
+            else if (k == "tech") ss >> tech;
+            else if (k == "denoiser") ss >> denoiser;
+            else if (k == "sharcaccum") ss >> sharcAccum;
+            else if (k == "nrcmaxrad") ss >> nrcMaxRad;
+            else if (k == "snapshots") ss >> snapshots;
+            else if (k == "eventboost") ss >> eventBoost;
+            else if (k == "eventclear") ss >> eventClear;
+            else if (k == "eventbypass") ss >> eventBypass;
+            else if (k == "bypassbounces") ss >> bypassBounces;     // 0 = contournement complet, K = pas de requete avant le rebond K
+            else if (k == "bypassadaptive") ss >> bypassAdaptive;   // 1 = arret quand la perte d'entrainement NRC se stabilise
+            else if (k == "probes") { std::getline(ss, probesPath); while (!probesPath.empty() && probesPath[0] == ' ') probesPath.erase(0, 1); }
+            else if (k == "spp") ss >> spp;
+            else if (k == "out") { std::getline(ss, out); while (!out.empty() && out[0] == ' ') out.erase(0, 1); }
+            else if (k == "warmup") ss >> warmup;
+            else if (k == "refframes") ss >> refFrames;
+            else if (k == "state")
+            {
+                BenchState s; ss >> s.sun >> s.sky; std::string tok;
+                while (ss >> tok) { if (tok[0] == 'o') s.obj = atoi(tok.c_str() + 1); else s.lights.push_back((float)atof(tok.c_str())); }
+                states.push_back(s);
+            }
+            else if (k == "depinv") ss >> depInv;
+            else if (k == "compactsnap") ss >> compactSnap;
+            else if (k == "depreset") ss >> depReset;
+            else if (k == "dlss") ss >> dlss;
+            else if (k == "dlssreset") ss >> dlssReset;   // 1 = l'historique DLSS est oublie a l'evenement
+            else if (k == "refs") { std::getline(ss, refDir); while (!refDir.empty() && refDir[0] == ' ') refDir.erase(0, 1); }   // dossier des references (defaut : ../ref)
+            else if (k == "depgrid") ss >> gridMin[0] >> gridMin[1] >> gridMin[2] >> gridMax[0] >> gridMax[1] >> gridMax[2];
+            else if (k == "object") ss >> objNode >> objHalf[0] >> objHalf[1] >> objHalf[2];
+            else if (k == "objpos") { std::array<float, 6> p = { 0, 0, 0, -1, -1, -1 }; ss >> p[0] >> p[1] >> p[2]; ss >> p[3] >> p[4] >> p[5]; objPos.push_back(p); }
+            else if (k == "campath") ss >> camAmp >> camYaw >> camPeriod;
+            else if (k == "poses") ss >> poses;
+            else if (k == "timeline" || k == "capture")
+            {
+                std::string rest; ss >> rest; std::stringstream t(rest); std::string tok;
+                while (std::getline(t, tok, ','))
+                {
+                    if (k == "capture") captures.push_back(atoi(tok.c_str()));
+                    else { size_t c = tok.find(':'); timeline.push_back({ atoi(tok.substr(0, c).c_str()), atoi(tok.substr(c + 1).c_str()) }); }
+                }
+            }
+        }
+        if (mode == "ref" && poses > 0)
+        {
+            std::vector<int> only;   // "refstates" optionnel : on ne calcule que ces etats
+            for (int s = 0; s < (int)states.size(); ++s) for (int p = 0; p < poses; ++p) for (int i = 0; i < refFrames; ++i) { seq.push_back(s); seqPose.push_back(p); }
+        }
+        else if (mode == "ref") for (int s = 0; s < (int)states.size(); ++s) for (int i = 0; i < refFrames; ++i) seq.push_back(s);
+        else for (auto& p : timeline) for (int i = 0; i < p.second; ++i) seq.push_back(p.first);
+        active = !seq.empty() && !states.empty();
+        return active;
+    }
+
+    std::string Path(const std::string& name) const { return out + "/" + name; }
+    float CamPhase(int f) const
+    {
+        if (camPeriod <= 0) return 0.f;
+        if (mode == "ref" && poses > 0) return f < 0 ? 0.f : (float)seqPose[f] / poses;
+        return f < 0 ? 0.f : (float)(f % camPeriod) / camPeriod;
+    }
+    int RefPose(int f) const
+    {
+        if (poses <= 0) return 0;
+        if (mode == "ref") return f < 0 ? 0 : seqPose[f];
+        int ph = f % camPeriod, step = camPeriod / poses;
+        return (ph % step == 0) ? ph / step : -1;
+    }
+    int SegKey(int f) const { return seq[f] * 1000 + ((mode == "ref" && poses > 0) ? seqPose[f] : 0); }
+    std::string RefName(int s, int p) const { return poses > 0 ? "ref_" + std::to_string(s) + "_" + std::to_string(p) + ".bin" : "ref_" + std::to_string(s) + ".bin"; }
+
+    static bool WriteImage(const std::string& path, int w, int h, const std::vector<float>& rgb)
+    {
+        FILE* fp = fopen(path.c_str(), "wb");
+        if (!fp) return false;
+        fwrite(&w, 4, 1, fp); fwrite(&h, 4, 1, fp);
+        fwrite(rgb.data(), 4, rgb.size(), fp);
+        fclose(fp);
+        return true;
+    }
+    static bool ReadImage(const std::string& path, int& w, int& h, std::vector<float>& rgb)
+    {
+        FILE* fp = fopen(path.c_str(), "rb");
+        if (!fp) return false;
+        fread(&w, 4, 1, fp); fread(&h, 4, 1, fp);
+        rgb.resize((size_t)w * h * 3);
+        fread(rgb.data(), 4, rgb.size(), fp);
+        fclose(fp);
+        return true;
+    }
+    // erreur par tuiles (moyennes de 60x60 pixels) : le bruit s'efface, le retard d'eclairage reste
+    static double TileRelErr(const std::vector<float>& a, const std::vector<float>& ref, int w, int h, int T = 60)
+    {
+        double s2 = 0, m = 0; int n = 0;
+        for (int ty = 0; ty + T <= h; ty += T) for (int tx = 0; tx + T <= w; tx += T)
+        {
+            double sa = 0, sr = 0;
+            for (int y = ty; y < ty + T; ++y) for (int x = tx; x < tx + T; ++x) for (int k = 0; k < 3; ++k)
+            { size_t i = 3 * ((size_t)y * w + x) + k; sa += a[i]; sr += ref[i]; }
+            sa /= 3.0 * T * T; sr /= 3.0 * T * T;
+            s2 += (sa - sr) * (sa - sr); m += sr; n++;
+        }
+        m /= std::max(n, 1);
+        return std::sqrt(s2 / std::max(n, 1)) / std::max(m, 1e-9);
+    }
+    bool LoadProbes()
+    {
+        if (probesPath.empty()) return false;
+        FILE* fp = fopen(probesPath.c_str(), "rb");
+        if (!fp) return false;
+        fread(&probeW, 4, 1, fp); fread(&probeH, 4, 1, fp);
+        probes.resize((size_t)probeW * probeH * std::max(poses, 1));
+        size_t got = fread(probes.data(), 1, probes.size(), fp);
+        if (got < probes.size()) probes.resize(got);
+        fclose(fp);
+        return true;
+    }
+    // par sonde (bit) : ecart de luminosite moyenne (%) et ecart perceptuel RMS de log(1 + x/m)
+    void ProbeMetrics(const std::vector<float>& a, const std::vector<float>& ref, int w, int h, int bit, double& biasPct, double& logRms, int pose = 0) const
+    {
+        const uint8_t* probes = this->probes.data() + (size_t)w * h * (((size_t)(pose + 1) * w * h <= this->probes.size()) ? pose : 0);
+        double sa = 0, sr = 0; size_t n = 0;
+        for (size_t p = 0; p < (size_t)w * h; ++p)
+            if ((probes[p] >> bit) & 1) { for (int k = 0; k < 3; ++k) { sa += a[3 * p + k]; sr += ref[3 * p + k]; } n += 3; }
+        if (!n || sr <= 0) { biasPct = 0; logRms = 0; return; }
+        double m = sr / n;
+        double s2 = 0;
+        for (size_t p = 0; p < (size_t)w * h; ++p)
+            if ((probes[p] >> bit) & 1)
+                for (int k = 0; k < 3; ++k) { double d = std::log1p(a[3 * p + k] / m) - std::log1p(ref[3 * p + k] / m); s2 += d * d; }
+        biasPct = (sa / sr - 1.0) * 100.0;
+        logRms = std::sqrt(s2 / n);
+    }
+    // erreur relative : RMSE (RVB) / moyenne de la reference
+    static double RelRmse(const std::vector<float>& a, const std::vector<float>& ref, double* meanOut = nullptr)
+    {
+        double s2 = 0, m = 0; size_t n = std::min(a.size(), ref.size());
+        for (size_t i = 0; i < n; ++i) { double d = (double)a[i] - ref[i]; s2 += d * d; m += ref[i]; }
+        m /= std::max<size_t>(n, 1);
+        if (meanOut) *meanOut = m;
+        return std::sqrt(s2 / std::max<size_t>(n, 1)) / std::max(m, 1e-9);
+    }
+};
diff --git a/Samples/Pathtracer/BenchSnap.hlsl b/Samples/Pathtracer/BenchSnap.hlsl
new file mode 100644
index 0000000..9571128
--- /dev/null
+++ b/Samples/Pathtracer/BenchSnap.hlsl
@@ -0,0 +1,57 @@
+// Banc : instantanes SHaRC compacts. Seules les entrees valides sont gardees : indice, cle, lumiere resolue (24 octets)
+struct SnapRec
+{
+    uint index;
+    uint sampleData;
+    uint2 key;
+    uint2 radiance;   // 4 x fp16 (radiance rgb + nombre d'echantillons)
+};
+
+RWStructuredBuffer<uint2>   u_Hash      : register(u0, space3);
+RWStructuredBuffer<uint4>   u_Resolved  : register(u3, space3);
+RWStructuredBuffer<SnapRec> u_Snap      : register(u5, space3);
+RWStructuredBuffer<uint>    u_Counter   : register(u6, space3);
+
+struct SnapConstants { uint capacity; uint count; uint pad0; uint pad1; };
+ConstantBuffer<SnapConstants> g_Snap : register(b0, space3);
+
+bool IsValid(uint id, out uint2 k, out uint4 r)
+{
+    k = u_Hash[id];
+    r = u_Resolved[id];
+    return (k.x | k.y) != 0 && (r.y >> 16) != 0;   // cle presente et au moins un echantillon
+}
+
+[numthreads(256, 1, 1)]
+void snapCount(uint id : SV_DispatchThreadID)
+{
+    if (id >= g_Snap.capacity) return;
+    uint2 k; uint4 r;
+    if (IsValid(id, k, r)) InterlockedAdd(u_Counter[0], 1);
+}
+
+[numthreads(256, 1, 1)]
+void snapPack(uint id : SV_DispatchThreadID)
+{
+    if (id >= g_Snap.capacity) return;
+    uint2 k; uint4 r;
+    if (!IsValid(id, k, r)) return;
+    uint slot;
+    InterlockedAdd(u_Counter[0], 1, slot);
+    if (slot >= g_Snap.count) return;
+    SnapRec rec;
+    rec.index = id;
+    rec.sampleData = r.z;
+    rec.key = k;
+    rec.radiance = r.xy;
+    u_Snap[slot] = rec;
+}
+
+[numthreads(256, 1, 1)]
+void snapRestore(uint id : SV_DispatchThreadID)
+{
+    if (id >= g_Snap.count) return;
+    SnapRec rec = u_Snap[id];
+    u_Hash[rec.index] = rec.key;
+    u_Resolved[rec.index] = uint4(rec.radiance, rec.sampleData & 0xFFFFu, 0);   // plus aucune image "perimee"
+}
