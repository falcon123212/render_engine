+// ------------------------------------------------------------------------------- banc d'essai
+void Pathtracer::BenchBeginFrame()
+{
+    if (!m_bench.active)
+        return;
+    auto sun = m_pathtracerScene->GetSunLight();
+    std::vector<std::shared_ptr<engine::Light>> lights;
+    for (auto l : m_pathtracerScene->GetScene()->GetSceneGraph()->GetLights())
+        if (l.get() != (engine::Light*)sun.get()) lights.push_back(l);
+    auto getI = [](const std::shared_ptr<engine::Light>& l) -> float {
+        if (auto p = std::dynamic_pointer_cast<engine::PointLight>(l)) return p->intensity;
+        if (auto s = std::dynamic_pointer_cast<engine::SpotLight>(l)) return s->intensity;
+        return 0.f; };
+    auto setI = [](const std::shared_ptr<engine::Light>& l, float v) {
+        if (auto p = std::dynamic_pointer_cast<engine::PointLight>(l)) p->intensity = v;
+        else if (auto s = std::dynamic_pointer_cast<engine::SpotLight>(l)) s->intensity = v; };
+    if (!m_bench.origSaved)
+    {
+        m_bench.origSun = sun ? sun->irradiance : 0.f;
+        m_bench.origSky = m_ui.skyIntensity;
+        for (auto& l : lights) m_bench.origLights.push_back(getI(l));
+        m_bench.origSaved = true;
+        m_ui.enableVSync = false;
+        std::filesystem::create_directories(m_bench.out);
+        if (m_bench.mode == "run")
+        {
+            for (size_t s = 0; s < m_bench.states.size(); ++s)
+                for (int p = 0; p < std::max(m_bench.poses, 1); ++p)
+                {
+                    std::vector<float> img; int w = 0, h = 0;
+                    if (!BenchConfig::ReadImage(m_bench.refDir.empty() ? m_bench.Path("../ref/" + m_bench.RefName((int)s, p)) : m_bench.refDir + "/" + m_bench.RefName((int)s, p), w, h, img)) img.clear();
+                    if (!img.empty()) { m_bench.refW = w; m_bench.refH = h; }
+                    m_bench.refs.push_back(img);
+                }
+            m_bench.csv = fopen(m_bench.Path("errors.csv").c_str(), "w");
+            m_bench.LoadProbes();
+            if (m_bench.csv)
+            {
+                fprintf(m_bench.csv, "frame,state,rel_rmse,ref_mean,tile_err,bypass,gpu_ms,copy_ms,loss");
+                for (int bit = 0; bit < 8 && !m_bench.probes.empty(); ++bit) fprintf(m_bench.csv, ",p%d_bias,p%d_log", bit, bit);
+                fprintf(m_bench.csv, "\n");
+            }
+        }
+        log::info("Bench : %d lampes ponctuelles/spots, soleil %.2f, ciel %.2f", (int)lights.size(), m_bench.origSun, m_bench.origSky);
+        {   // diagnostic : lampes vues par le banc
+            FILE* inf = fopen(m_bench.Path("bench_info.txt").c_str(), "w");
+            if (inf)
+            {
+                fprintf(inf, "soleil irradiance=%.4f ciel=%.4f lampes=%d\n", m_bench.origSun, m_bench.origSky, (int)lights.size());
+                for (auto& l : lights)
+                {
+                    dm::double3 pos = l->GetPosition();
+                    fprintf(inf, "  %s intensite=%.3f pos=(%.2f, %.2f, %.2f)\n", l->GetName().c_str(), getI(l), pos.x, pos.y, pos.z);
+                }
+                fclose(inf);
+            }
+        }
+        if (m_bench.csv) fprintf(m_bench.csv, "# sharc_entries=%u snapshot_bytes=%llu dep_bytes=%llu\n", m_sharcEntriesNum, (unsigned long long)m_sharcEntriesNum * (8ull + 16ull + 16ull),
+            (unsigned long long)(m_benchDepBuffer ? 2 * m_benchDepBuffer->getDesc().byteSize : 0));
+    }
+    int stateIdx;
+    if (m_bench.warmup > 0) { m_bench.warmup--; stateIdx = m_bench.seq[0]; m_bench.frame = -1; }
+    else
+    {
+        m_bench.frame++;
+        if (m_bench.frame >= (int)m_bench.seq.size())
+        {
+            if (m_bench.csv) { fclose(m_bench.csv); m_bench.csv = nullptr; }
+            m_bench.active = false;
+            glfwSetWindowShouldClose(GetDeviceManager()->GetWindow(), 1);
+            return;
+        }
+        stateIdx = m_bench.seq[m_bench.frame];
+        // ---- evenement signale par le moteur : changement d'etat
+        if (m_bench.frame > 0 && m_bench.seq[m_bench.frame] != m_bench.seq[m_bench.frame - 1])
+        {
+            int prev = m_bench.seq[m_bench.frame - 1];
+            bool restored = false;
+#if ENABLE_SHARC
+            if (m_bench.snapshots && m_ui.techSelection == TechSelection::Sharc && m_sharcHashEntriesBuffer)
+            {
+                if (m_bench.frame - m_benchLastEvent >= 20)   // instantane de l'etat quitte (s'il etait stable)
+                {
+                    SharcSnapshot* slot = nullptr;
+                    for (auto& s : m_benchSnaps) if (s.state == prev) slot = &s;
+                    if (!slot && m_bench.compactSnap) { m_benchSnaps.push_back({}); slot = &m_benchSnaps.back(); }
+                    if (m_bench.compactSnap) { slot->state = prev; BenchSnapSave(*slot); }
+                    else if (!slot)
+                    {
+                        m_benchSnaps.push_back({});
+                        slot = &m_benchSnaps.back();
+                        auto mk = [&](nvrhi::IBuffer* src, const char* nm) { nvrhi::BufferDesc d = src->getDesc(); d.debugName = nm; return GetDevice()->createBuffer(d); };
+                        slot->hash = mk(m_sharcHashEntriesBuffer, "snapHash");
+                        slot->accum = mk(m_sharcAccumulationBuffer, "snapAccum");
+                        slot->resolved = mk(m_sharcResolvedBuffer, "snapResolved");
+                    }
+                    if (!m_bench.compactSnap)
+                    {
+                        slot->state = prev;
+                        BenchCopySharc(slot->hash, slot->accum, slot->resolved, m_sharcHashEntriesBuffer, m_sharcAccumulationBuffer, m_sharcResolvedBuffer);
+                    }
+                }
+                for (auto& s : m_benchSnaps)
+                    if (s.state == stateIdx)   // etat deja vu : restauration instantanee
+                    {
+                        if (m_bench.compactSnap) BenchSnapRestore(s);
+                        else BenchCopySharc(m_sharcHashEntriesBuffer, m_sharcAccumulationBuffer, m_sharcResolvedBuffer, s.hash, s.accum, s.resolved);
+                        restored = true;
+                    }
+            }
+#endif
+            if (m_bench.eventBoost > 0 && !restored)
+                m_benchBoost = m_bench.eventBoost;
+            if (m_bench.eventBypass > 0 && !restored)
+            {
+                m_benchBypass = m_bench.eventBypass;   // contournement : on ne lit plus le cache pendant qu'il se reconstruit
+                m_benchEma.clear(); m_benchBypassAge = 0;
+            }
+#if ENABLE_SHARC
+            // etat nouveau + changement global (toute la scene en depend) : on vide le cache au lieu de laisser recirculer l'ancienne lumiere
+            if (m_bench.eventClear && !restored && m_ui.techSelection == TechSelection::Sharc)
+                m_ui.sharcEnableClear = true;
+#endif
+#if ENABLE_SHARC
+            // invalidation ciblee : seules les entrees qui dependent de ce qui a change sont remises a zero
+            if (m_bench.depInv && !restored && m_ui.techSelection == TechSelection::Sharc)
+            {
+                const BenchState& a = m_bench.states[prev];
+                const BenchState& b = m_bench.states[stateIdx];
+                auto all = m_pathtracerScene->GetScene()->GetSceneGraph()->GetLights();
+                size_t j = 0;
+                for (size_t i = 0; i < all.size() && i < 31; ++i)
+                {
+                    float fa, fb;
+                    if (all[i].get() == (engine::Light*)sun.get()) { fa = a.sun; fb = b.sun; }
+                    else { fa = j < a.lights.size() ? a.lights[j] : 1.f; fb = j < b.lights.size() ? b.lights[j] : 1.f; ++j; }
+                    if (fa != fb) m_benchInv[3] |= 1u << i;
+                }
+                if (a.sky != b.sky) m_benchInv[3] |= 0x80000000u;
+                if (a.obj != b.obj) { BenchObjVoxels(a.obj, m_benchInv); BenchObjVoxels(b.obj, m_benchInv); }
+                m_benchCountBefore = BenchCountValid();   // diagnostic : part du cache effacee
+                m_benchCountAfter = 2;
+            }
+#endif
+            if (m_bench.dlssReset) m_benchDlssReset = true;
+            m_benchLastEvent = m_bench.frame;
+        }
+    }
+#if ENABLE_SHARC
+    static bool clearArmed = false;   // le vidage ne dure qu'une image
+    if (clearArmed) { m_ui.sharcEnableClear = false; clearArmed = false; }
+    if (m_ui.sharcEnableClear && m_bench.eventClear) clearArmed = true;
+#endif
+    if (m_benchCountAfter > 0 && --m_benchCountAfter == 0)
+    {
+        uint32_t after = BenchCountValid();
+        if (!m_benchSnapLog) m_benchSnapLog = fopen(m_bench.Path("snapshots.txt").c_str(), "w");
+        if (m_benchSnapLog) { fprintf(m_benchSnapLog, "invalidation frame=%d valid_before=%u valid_after=%u kept=%.1f%%\n", m_bench.frame, m_benchCountBefore, after, 100.0 * after / std::max(m_benchCountBefore, 1u)); fflush(m_benchSnapLog); }
+    }
+    // ---- arret pilote : une image sur 6 pendant le contournement consulte le cache (image de controle)
+    m_benchCheckFrame = m_bench.bypassAdaptive && m_benchBypass > 0 && m_benchBypassAge >= 5 && (m_benchBypassAge % 6 == 5);
+    // ---- reaction declenchee par l'evenement (rampe), sinon reglages par defaut
+    if (m_benchDefaultSharcAccum < 0) m_benchDefaultSharcAccum = m_ui.sharcAccumulationFrameNum;
+#if ENABLE_NRC
+    if (m_benchDefaultNrcIter < 0) m_benchDefaultNrcIter = m_ui.nrcNumTrainingIterations;
+#endif
+    if (m_benchBoost > 0)
+    {
+        int k = m_bench.eventBoost - m_benchBoost;   // images depuis l'evenement
+        m_ui.sharcAccumulationFrameNum = std::min(m_benchDefaultSharcAccum, 2 + k / 2);
+#if ENABLE_NRC
+        m_ui.nrcNumTrainingIterations = 4;
+#endif
+        m_benchBoost--;
+    }
+    else
+    {
+        m_ui.sharcAccumulationFrameNum = m_benchDefaultSharcAccum;
+#if ENABLE_NRC
+        m_ui.nrcNumTrainingIterations = m_benchDefaultNrcIter;
+#endif
+    }
+    const BenchState& st = m_bench.states[stateIdx];
+    if (!m_bench.objNode.empty() && st.obj != m_benchObjCur && st.obj < (int)m_bench.objPos.size())
+    {
+        if (!m_benchObj)
+            for (engine::SceneGraphWalker w(m_pathtracerScene->GetScene()->GetSceneGraph()->GetRootNode().get()); w; w.Next(true))
+                if (w->GetName() == m_bench.objNode) { m_benchObj = w->shared_from_this(); break; }
+        if (m_benchObj)
+        {
+            auto& p = m_bench.objPos[st.obj];
+            m_benchObj->SetTranslation(dm::double3(p[0], p[1], p[2]));
+            if (p[3] > 0.f) m_benchObj->SetScaling(dm::double3(p[3], p[4], p[5]));
+            m_benchObjCur = st.obj;
+        }
+    }
+    if (m_bench.camPeriod > 0)
+    {
+        if (!m_benchCamSaved) { m_benchCamPos = m_camera.GetPosition(); m_benchCamDir = m_camera.GetDir(); m_benchCamUp = m_camera.GetUp(); m_benchCamSaved = true; }
+        const float a = 2.f * dm::PI_f * m_bench.CamPhase(m_bench.frame);
+        dm::float3 right = dm::normalize(dm::cross(m_benchCamDir, dm::float3(0.f, 1.f, 0.f)));
+        dm::float3 pos = m_benchCamPos + right * (m_bench.camAmp * std::sin(a)) + m_benchCamDir * (0.5f * m_bench.camAmp * (1.f - std::cos(a)));
+        float yaw = m_bench.camYaw * dm::PI_f / 180.f * std::sin(a);
+        dm::float3 dir = m_benchCamDir * std::cos(yaw) + right * std::sin(yaw);
+        m_camera.LookAt(pos, pos + dir);
+    }
+    if (sun) sun->irradiance = m_bench.origSun * st.sun;
+    m_ui.skyIntensity = m_bench.origSky * st.sky;
+    for (size_t i = 0; i < lights.size(); ++i)
+        setI(lights[i], m_bench.origLights[i] * (i < st.lights.size() ? st.lights[i] : 1.f));
+    if (m_bench.mode == "run")
+        m_resetAccumulation = true;                 // pas d'accumulation : pipeline temps reel image par image
+    else if (m_bench.frame <= 0 || m_bench.SegKey(m_bench.frame) != m_bench.SegKey(m_bench.frame - 1))
+        m_resetAccumulation = true;                 // reference : accumulation par etat (et par pose)
+}
+
+void Pathtracer::BenchCopySharc(nvrhi::IBuffer* dh, nvrhi::IBuffer* da, nvrhi::IBuffer* dr, nvrhi::IBuffer* sh, nvrhi::IBuffer* sa, nvrhi::IBuffer* sr)
+{
+    nvrhi::IDevice* device = GetDevice();
+    nvrhi::CommandListHandle cl = device->createCommandList();
+    if (!m_benchCopyTimer) m_benchCopyTimer = device->createTimerQuery();
+    else device->resetTimerQuery(m_benchCopyTimer);
+    cl->open();
+    cl->beginTimerQuery(m_benchCopyTimer);
+    cl->copyBuffer(dh, 0, sh, 0, sh->getDesc().byteSize);
+    cl->copyBuffer(da, 0, sa, 0, sa->getDesc().byteSize);
+    cl->copyBuffer(dr, 0, sr, 0, sr->getDesc().byteSize);
+    cl->endTimerQuery(m_benchCopyTimer);
+    cl->close();
+    device->executeCommandList(cl);
+    device->waitForIdle();
+    m_benchEventMs += device->getTimerQueryTime(m_benchCopyTimer) * 1000.f;
+}
+
+void Pathtracer::BenchSnapDispatch(nvrhi::ICommandList* cl, nvrhi::IComputePipeline* pso, nvrhi::IBindingSet* set, uint32_t threads, uint32_t count)
+{
+    nvrhi::ComputeState cs;
+    cs.pipeline = pso;
+    cs.bindings = { set };
+    cl->setComputeState(cs);
+    uint32_t pc[4] = { m_sharcEntriesNum, count, 0, 0 };
+    cl->setPushConstants(pc, sizeof(pc));
+    cl->dispatch((threads + 255) / 256, 1, 1);
+}
+
+// instantane compact : on compte les entrees valides, on alloue juste ce qu'il faut, on les recopie (24 octets chacune)
+void Pathtracer::BenchSnapSave(SharcSnapshot& s)
+{
+    nvrhi::IDevice* device = GetDevice();
+    if (!m_benchCopyTimer) m_benchCopyTimer = device->createTimerQuery();
+    auto makeSet = [&](nvrhi::IBuffer* rec) {
+        nvrhi::BindingSetDesc d;
+        d.bindings = { nvrhi::BindingSetItem::StructuredBuffer_UAV(0, m_sharcHashEntriesBuffer), nvrhi::BindingSetItem::StructuredBuffer_UAV(3, m_sharcResolvedBuffer),
+                       nvrhi::BindingSetItem::StructuredBuffer_UAV(5, rec), nvrhi::BindingSetItem::StructuredBuffer_UAV(6, m_benchCounter),
+                       nvrhi::BindingSetItem::PushConstants(0, 16) };
+        return device->createBindingSet(d, m_benchSnapLayout); };
+    // 1) comptage
+    float ms = 0.f;
+    {
+        if (!s.rec) { nvrhi::BufferDesc d; d.byteSize = 24; d.structStride = 24; d.canHaveUAVs = true; d.initialState = nvrhi::ResourceStates::UnorderedAccess; d.keepInitialState = true; d.debugName = "snapRec"; s.rec = device->createBuffer(d); }
+        nvrhi::BindingSetHandle tmp = makeSet(s.rec);
+        nvrhi::CommandListHandle cl = device->createCommandList();
+        device->resetTimerQuery(m_benchCopyTimer);
+        cl->open();
+        cl->beginTimerQuery(m_benchCopyTimer);
+        cl->clearBufferUInt(m_benchCounter, 0);
+        BenchSnapDispatch(cl, m_benchSnapCount, tmp, m_sharcEntriesNum, 0);
+        cl->endTimerQuery(m_benchCopyTimer);
+        cl->copyBuffer(m_benchCounterStaging, 0, m_benchCounter, 0, 4);
+        cl->close();
+        device->executeCommandList(cl);
+        device->waitForIdle();
+        ms += device->getTimerQueryTime(m_benchCopyTimer) * 1000.f;
+        const uint32_t* p = (const uint32_t*)device->mapBuffer(m_benchCounterStaging, nvrhi::CpuAccessMode::Read);
+        s.count = p ? *p : 0;
+        device->unmapBuffer(m_benchCounterStaging);
+    }
+    // 2) tampon a la bonne taille, recopie
+    {
+        nvrhi::BufferDesc d; d.byteSize = (uint64_t)std::max(s.count, 1u) * 24; d.structStride = 24; d.canHaveUAVs = true;
+        d.initialState = nvrhi::ResourceStates::UnorderedAccess; d.keepInitialState = true; d.debugName = "snapRec";
+        s.rec = device->createBuffer(d);
+        s.recSet = makeSet(s.rec);
+        nvrhi::CommandListHandle cl = device->createCommandList();
+        device->resetTimerQuery(m_benchCopyTimer);
+        cl->open();
+        cl->beginTimerQuery(m_benchCopyTimer);
+        cl->clearBufferUInt(m_benchCounter, 0);
+        BenchSnapDispatch(cl, m_benchSnapPack, s.recSet, m_sharcEntriesNum, s.count);
+        cl->endTimerQuery(m_benchCopyTimer);
+        cl->close();
+        device->executeCommandList(cl);
+        device->waitForIdle();
+        ms += device->getTimerQueryTime(m_benchCopyTimer) * 1000.f;
+    }
+    m_benchEventMs += ms;
+    if (!m_benchSnapLog) m_benchSnapLog = fopen(m_bench.Path("snapshots.txt").c_str(), "w");
+    if (m_benchSnapLog) { fprintf(m_benchSnapLog, "save frame=%d state=%d entries=%u bytes=%llu gpu_ms=%.3f\n", m_bench.frame, s.state, s.count, (unsigned long long)s.count * 24ull, ms); fflush(m_benchSnapLog); }
+}
+
+uint32_t Pathtracer::BenchCountValid()
+{
+    nvrhi::IDevice* device = GetDevice();
+    nvrhi::BufferDesc d; d.byteSize = 24; d.structStride = 24; d.canHaveUAVs = true; d.initialState = nvrhi::ResourceStates::UnorderedAccess; d.keepInitialState = true;
+    static nvrhi::BufferHandle dummy; if (!dummy) dummy = device->createBuffer(d);
+    nvrhi::BindingSetDesc sd;
+    sd.bindings = { nvrhi::BindingSetItem::StructuredBuffer_UAV(0, m_sharcHashEntriesBuffer), nvrhi::BindingSetItem::StructuredBuffer_UAV(3, m_sharcResolvedBuffer),
+                    nvrhi::BindingSetItem::StructuredBuffer_UAV(5, dummy), nvrhi::BindingSetItem::StructuredBuffer_UAV(6, m_benchCounter), nvrhi::BindingSetItem::PushConstants(0, 16) };
+    nvrhi::BindingSetHandle set = device->createBindingSet(sd, m_benchSnapLayout);
+    nvrhi::CommandListHandle cl = device->createCommandList();
+    cl->open();
+    cl->clearBufferUInt(m_benchCounter, 0);
+    BenchSnapDispatch(cl, m_benchSnapCount, set, m_sharcEntriesNum, 0);
+    cl->copyBuffer(m_benchCounterStaging, 0, m_benchCounter, 0, 4);
+    cl->close();
+    device->executeCommandList(cl);
+    device->waitForIdle();
+    const uint32_t* p = (const uint32_t*)device->mapBuffer(m_benchCounterStaging, nvrhi::CpuAccessMode::Read);
+    uint32_t n = p ? *p : 0;
+    device->unmapBuffer(m_benchCounterStaging);
+    return n;
+}
+
+void Pathtracer::BenchSnapRestore(SharcSnapshot& s)
+{
+    nvrhi::IDevice* device = GetDevice();
+    if (!m_benchCopyTimer) m_benchCopyTimer = device->createTimerQuery();
+    nvrhi::CommandListHandle cl = device->createCommandList();
+    device->resetTimerQuery(m_benchCopyTimer);
+    cl->open();
+    cl->beginTimerQuery(m_benchCopyTimer);
+    cl->clearBufferUInt(m_sharcHashEntriesBuffer, m_sharcInvalidEntry);
+    cl->clearBufferUInt(m_sharcAccumulationBuffer, 0);
+    cl->clearBufferUInt(m_sharcResolvedBuffer, 0);
+    cl->clearBufferUInt(m_benchDepBuffer, 0);   // les masques se reconstruisent des les images suivantes
+    cl->clearBufferUInt(m_benchDepBuffer1, 0);
+    if (s.count) BenchSnapDispatch(cl, m_benchSnapRestore, s.recSet, s.count, s.count);
+    cl->endTimerQuery(m_benchCopyTimer);
+    cl->close();
+    device->executeCommandList(cl);
+    device->waitForIdle();
+    float ms = device->getTimerQueryTime(m_benchCopyTimer) * 1000.f;
+    m_benchEventMs += ms;
+    if (!m_benchSnapLog) m_benchSnapLog = fopen(m_bench.Path("snapshots.txt").c_str(), "w");
+    if (m_benchSnapLog) { fprintf(m_benchSnapLog, "restore frame=%d state=%d entries=%u gpu_ms=%.3f\n", m_bench.frame, s.state, s.count, ms); fflush(m_benchSnapLog); }
+}
+
+// zones de dependance touchees par la boite englobante de l'objet (avec une marge)
+void Pathtracer::BenchObjVoxels(int obj, uint32_t inv[4])
+{
+    if (obj < 0 || obj >= (int)m_bench.objPos.size()) return;
+    const int G[3] = { 6, 4, 4 };
+    const float margin = 0.25f;
+    float lo[3], hi[3];
+    for (int k = 0; k < 3; ++k)
+    {
+        float half = m_bench.objPos[obj][3] > 0.f ? 0.5f * m_bench.objPos[obj][3 + k] : m_bench.objHalf[k];
+        lo[k] = m_bench.objPos[obj][k] - half - margin; hi[k] = m_bench.objPos[obj][k] + half + margin;
+    }
+    for (int z = 0; z < G[2]; ++z) for (int y = 0; y < G[1]; ++y) for (int x = 0; x < G[0]; ++x)
+    {
+        int v[3] = { x, y, z };
+        bool overlap = true;
+        for (int k = 0; k < 3; ++k)
+        {
+            float cs = (m_bench.gridMax[k] - m_bench.gridMin[k]) / G[k];
+            float c0 = m_bench.gridMin[k] + cs * v[k], c1 = c0 + cs;
+            if (hi[k] < c0 || lo[k] > c1) overlap = false;
+        }
+        if (overlap) { int b = x + G[0] * (y + G[1] * z); inv[b / 32] |= 1u << (b % 32); }
+    }
+}
+
+bool Pathtracer::BenchReadback(std::vector<float>& rgb, int& w, int& h)
+{
+    nvrhi::IDevice* device = GetDevice();
+    // accumulation : image dans le tampon d'accumulation ; NRD : image debruitee dans outPathTracer
+    const bool dlssOn = m_ui.dlssSupported && m_ui.dlssMode != DlssMode::None;   // DLSS : image de sortie dans le tampon d'accumulation
+    nvrhi::TextureHandle src = (m_ui.denoiserType == DenoiserType::Accumulation || dlssOn) ? m_accumulationBuffer : m_renderTargets->outPathTracer;
+    if (!src)
+        return false;
+    const nvrhi::TextureDesc& d = src->getDesc();
+    if (!m_benchStaging || m_benchStaging->getDesc().width != d.width || m_benchStaging->getDesc().height != d.height)
+    {
+        nvrhi::TextureDesc sd = d;
+        sd.isUAV = false; sd.isRenderTarget = false;
+        sd.initialState = nvrhi::ResourceStates::CopyDest; sd.keepInitialState = true;
+        sd.debugName = "BenchStaging";
+        m_benchStaging = device->createStagingTexture(sd, nvrhi::CpuAccessMode::Read);
+    }
+    nvrhi::CommandListHandle cl = device->createCommandList();
+    cl->open();
+    cl->copyTexture(m_benchStaging, nvrhi::TextureSlice(), src, nvrhi::TextureSlice());
+    cl->close();
+    device->executeCommandList(cl);
+    device->waitForIdle();
+    size_t pitch = 0;
+    const uint8_t* p = (const uint8_t*)device->mapStagingTexture(m_benchStaging, nvrhi::TextureSlice(), nvrhi::CpuAccessMode::Read, &pitch);
+    if (!p)
+        return false;
+    w = (int)d.width; h = (int)d.height;
+    rgb.resize((size_t)w * h * 3);
+    for (int y = 0; y < h; ++y)
+    {
+        const float* row = (const float*)(p + (size_t)y * pitch);
+        for (int x = 0; x < w; ++x) for (int k = 0; k < 3; ++k) rgb[3 * ((size_t)y * w + x) + k] = row[4 * x + k];
+    }
+    device->unmapStagingTexture(m_benchStaging);
+    return true;
+}
+
+void Pathtracer::BenchEndFrame()
+{
+    const int wasBypass = m_benchCheckFrame ? 2 : (m_benchBypass > 0 ? 1 : 0);
+    const bool wasCheck = m_benchCheckFrame;
+    if (m_benchBypass > 0)
+    {
+        m_benchBypass--;
+        m_benchBypassAge++;
+        if (m_benchBypass == 0) { m_benchEma.clear(); m_benchBypassAge = 0; }
+    }
+    if (!m_bench.active || m_bench.frame < 0)
+        return;
+    int f = m_bench.frame;
+    bool lastOfSegment = (f + 1 >= (int)m_bench.seq.size()) || m_bench.SegKey(f + 1) != m_bench.SegKey(f);
+    const int pose = m_bench.RefPose(f);
+    bool wanted = (m_bench.mode == "ref") ? lastOfSegment : (pose >= 0);
+    for (int cf : m_bench.captures) if (cf == f) wanted = true;
+    if (!wanted && m_bench.poses > 0)
+    {   // camera mobile : pas de reference pour cette image, on ne garde que le temps GPU
+        if (m_bench.csv)
+        {
+            float gpuMs = -1.f;
+            if (m_benchTimer && GetDevice()->pollTimerQuery(m_benchTimer)) gpuMs = GetDevice()->getTimerQueryTime(m_benchTimer) * 1000.f;
+            fprintf(m_bench.csv, "%d,%d,-1,-1,-1,%d,%.4f,%.4f,0", f, m_bench.seq[f], wasBypass, gpuMs, m_benchEventMs);
+            for (int bit = 0; bit < 8 && !m_bench.probes.empty(); ++bit) fprintf(m_bench.csv, ",0,0");
+            fprintf(m_bench.csv, "\n");
+            m_benchEventMs = 0.f;
+        }
+        return;
+    }
+    bool isRef = m_bench.mode == "ref";
+    if (isRef && !lastOfSegment)
+        return;
+    std::vector<float> rgb; int w = 0, h = 0;
+    if (!BenchReadback(rgb, w, h))
+        return;
+    int s = m_bench.seq[f];
+    if (!isRef && m_bench.bypassAdaptive && (wasBypass > 0))
+    {
+        // luminosite : image entiere + grille 8x4
+        std::vector<double> v(33, 0.0); std::vector<double> cnt(33, 0.0);
+        for (int y = 0; y < h; ++y) for (int x = 0; x < w; ++x)
+        {
+            size_t p = (size_t)y * w + x; double l = rgb[3 * p] + rgb[3 * p + 1] + rgb[3 * p + 2];
+            int t = 1 + (y * 4 / h) * 8 + (x * 8 / w);
+            v[0] += l; cnt[0] += 1; v[t] += l; cnt[t] += 1;
+        }
+        for (int t = 0; t < 33; ++t) v[t] /= std::max(cnt[t], 1.0);
+        if (!wasCheck)
+        {
+            if (m_benchEma.empty()) m_benchEma = v;
+            else for (int t = 0; t < 33; ++t) m_benchEma[t] = 0.7 * m_benchEma[t] + 0.3 * v[t];
+        }
+        else if (!m_benchEma.empty())
+        {
+            double dImg = std::abs(v[0] / std::max(m_benchEma[0], 1e-9) - 1.0);
+            std::vector<double> dt;
+            for (int t = 1; t < 33; ++t) if (m_benchEma[t] > 0.05 * m_benchEma[0]) dt.push_back(std::abs(v[t] / m_benchEma[t] - 1.0));
+            std::sort(dt.begin(), dt.end());
+            double d90 = dt.empty() ? 0.0 : dt[(size_t)(0.9 * (dt.size() - 1))];
+            if (dImg < 0.03 && d90 < 0.06) { m_benchBypass = 0; m_benchEma.clear(); m_benchBypassAge = 0; }   // le cache a rattrape
+        }
+    }
+    if (isRef)
+    {
+        BenchConfig::WriteImage(m_bench.Path(m_bench.RefName(s, pose)), w, h, rgb);
+        log::info("Bench : reference etat %d enregistree (%dx%d)", s, w, h);
+        return;
+    }
+    double mean = 0, e = -1, te = -1;
+    const int ri = s * std::max(m_bench.poses, 1) + std::max(pose, 0);
+    if (pose >= 0 && ri < (int)m_bench.refs.size() && !m_bench.refs[ri].empty() && m_bench.refW == w && m_bench.refH == h)
+    {
+        e = BenchConfig::RelRmse(rgb, m_bench.refs[ri], &mean);
+        te = BenchConfig::TileRelErr(rgb, m_bench.refs[ri], w, h);
+    }
+    if (m_bench.csv)
+    {
+        float gpuMs = -1.f;
+        if (m_benchTimer && GetDevice()->pollTimerQuery(m_benchTimer)) gpuMs = GetDevice()->getTimerQueryTime(m_benchTimer) * 1000.f;
+        fprintf(m_bench.csv, "%d,%d,%.6f,%.6f,%.6f,%d,%.4f,%.4f,%.6g", f, s, e, mean, te, wasBypass, gpuMs, m_benchEventMs, m_benchLoss);
+        m_benchEventMs = 0.f;
+        bool okp = !m_bench.probes.empty() && m_bench.probeW == w && m_bench.probeH == h && e >= 0;
+        for (int bit = 0; bit < 8 && !m_bench.probes.empty(); ++bit)
+        {
+            double bias = 0, lg = 0;
+            if (okp) m_bench.ProbeMetrics(rgb, m_bench.refs[ri], w, h, bit, bias, lg, std::max(pose, 0));
+            fprintf(m_bench.csv, ",%.4f,%.5f", bias, lg);
+        }
+        fprintf(m_bench.csv, "\n");
+        fflush(m_bench.csv);
+    }
+    for (int cf : m_bench.captures)
+        if (cf == f) BenchConfig::WriteImage(m_bench.Path("frame_" + std::to_string(f) + ".bin"), w, h, rgb);
 }
 
